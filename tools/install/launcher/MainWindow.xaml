<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptScaler NR"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        Background="#FF12141A"
        Foreground="#FFF2F4F8"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">
  <Window.Resources>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="#FF1C2028"/>
      <Setter Property="BorderBrush" Value="#FF2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#FFE8EEFF"/>
      <Setter Property="Foreground" Value="#FF12141A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="#FF1C2028"/>
      <Setter Property="Foreground" Value="#FFF2F4F8"/>
      <Setter Property="BorderBrush" Value="#FF2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFF2F4F8"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF252C3A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF2F384A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="#FF2A3140" BorderThickness="0,0,0,1" Height="80">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="238"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="OptScaler NR" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Background="#FF1C2028" BorderBrush="#FF2A3140" BorderThickness="1" CornerRadius="6" Height="40" Margin="12,0,28,0" MaxWidth="440" HorizontalAlignment="Stretch">
          <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#FFF2F4F8" VerticalContentAlignment="Center" Margin="12,0"/>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LibraryTab" Content="游戏库" Style="{StaticResource GhostButton}" Width="96" Margin="0,0,8,0"/>
          <Button x:Name="SettingsTab" Content="设置" Style="{StaticResource GhostButton}" Width="96"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="#FF2A3140" BorderThickness="0,1,0,0" Height="36">
      <DockPanel Margin="28,0">
        <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#FF9AA3B2" Text="0 款游戏"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF9AA3B2" Text=""/>
      </DockPanel>
    </Border>
    <Grid>
    <Grid x:Name="LibraryPage" Margin="28,18,28,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox x:Name="FilterCombo" Width="120" Height="34" Margin="0,0,8,0"/>
          <Button x:Name="AddButton" Content="+ 添加游戏" Style="{StaticResource GhostButton}" Width="120"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="你的游戏库" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="选择一个游戏以开始。" Foreground="#FF9AA3B2" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Surface}" Margin="0,0,16,0" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="游戏" Foreground="#FF9AA3B2" Margin="8,4,8,8"/>
            <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="4" Background="#FF2A3140" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Initial}" Foreground="#FFF2F4F8" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#FFF2F4F8"/>
                      <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="#FF9AA3B2"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" Foreground="{Binding StatusBrush}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Surface}" Padding="22" MinHeight="220">
              <StackPanel>
                <TextBlock x:Name="HeroKicker" Text="已选游戏" Foreground="#FF9AA3B2" FontSize="12"/>
                <TextBlock x:Name="HeroTitle" Text="选择一个游戏" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock x:Name="HeroMeta" Text="" Foreground="#FF9AA3B2" Margin="0,6,0,0"/>
                <TextBlock x:Name="HeroPath" Text="" Foreground="#FF9AA3B2" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button x:Name="PrimaryButton" Content="选择一个游戏" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="196" Margin="0,18,0,0" IsEnabled="False"/>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,0" IsIndeterminate="False"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="游戏详情" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="注入" Foreground="#FF9AA3B2" Margin="0,14,0,4"/>
                <TextBlock x:Name="InjectText" TextWrapping="Wrap" Text="选择游戏后检查它加载哪个 DLL。"/>
                <ComboBox x:Name="ProxyCombo" Height="32" Margin="0,8,0,0"/>
                <Button x:Name="ChangeExeButton" Content="更换游戏 EXE" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <TextBlock Text="后端" Foreground="#FF9AA3B2" Margin="0,16,0,6"/>
                <CheckBox x:Name="LmxxfCheck" Content="lmxxf" Foreground="#FFF2F4F8" Margin="0,2"/>
                <TextBlock x:Name="LmxxfReason" Foreground="#FF9AA3B2" Margin="22,0,0,6"/>
                <CheckBox x:Name="DanielCheck" Content="daniel" Foreground="#FFF2F4F8" Margin="0,2"/>
                <TextBlock x:Name="DanielReason" Foreground="#FF9AA3B2" Margin="22,0,0,6"/>
                <CheckBox x:Name="MochiCheck" Content="mochizuki" Foreground="#FFF2F4F8" Margin="0,2"/>
                <TextBlock x:Name="MochiReason" Foreground="#FF9AA3B2" Margin="22,0,0,6"/>
                <DockPanel Margin="0,8,0,0">
                  <TextBlock Text="当前后端" VerticalAlignment="Center" Width="88"/>
                  <ComboBox x:Name="ActiveCombo" Height="32"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <CheckBox x:Name="ReplaceIni" IsChecked="True" VerticalAlignment="Center" Foreground="#FFF2F4F8"/>
                  <TextBlock Text="Replace existing OptiScaler.ini" VerticalAlignment="Center" Margin="8,0,8,0"/>
                  <TextBlock Text="recommended" Foreground="#FF9AA3B2" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="UninstallButton" Content="卸载" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False"/>
                <DockPanel Margin="0,14,0,4">
                  <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="打开完整日志" Style="{StaticResource GhostButton}" Width="120"/>
                  <TextBlock Text="日志" Foreground="#FF9AA3B2" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="LogView" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="#FF12141A" Foreground="#FF9AA3B2" BorderThickness="0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <StackPanel x:Name="SettingsPage" Margin="28,24" Visibility="Collapsed">
      <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="语言" Margin="0,18,0,6" Foreground="#FF9AA3B2"/>
      <ComboBox x:Name="LangCombo" Width="160" Height="32" HorizontalAlignment="Left"/>
      <CheckBox x:Name="ScanOnStartup" Content="启动时扫描" IsChecked="True" Margin="0,16,0,0" Foreground="#FFF2F4F8"/>
      <Button x:Name="RefreshButton" Content="刷新游戏库" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      <TextBlock Text="安装包目录（源码调试时选择完整解压包）" Margin="0,18,0,6" Foreground="#FF9AA3B2"/>
      <DockPanel>
        <Button x:Name="PackageBrowse" DockPanel.Dock="Right" Content="浏览…" Style="{StaticResource GhostButton}" Width="96" Margin="8,0,0,0"/>
        <TextBox x:Name="PackageRootBox" Height="32" VerticalContentAlignment="Center" Background="#FF1C2028" Foreground="#FFF2F4F8" BorderBrush="#FF2A3140"/>
      </DockPanel>
    </StackPanel>
    </Grid>
  </DockPanel>
</Window>

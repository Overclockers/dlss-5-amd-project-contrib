<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptScaler NR Setup"
        Width="760" Height="640"
        MinWidth="640" MinHeight="520"
        Background="#FF1B1D23"
        Foreground="#FFF2F3F5"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <ComboBox x:Name="LangCombo" DockPanel.Dock="Right" Width="88" Height="28"/>
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Text="OptScaler NR"/>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Height="8" IsIndeterminate="False" Minimum="0" Maximum="1"/>
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#FF9AA3B2" Text="Select a game executable."/>
      <UniformGrid Columns="3" Margin="0,12,0,0">
        <Button x:Name="InstallButton" Content="Install" Margin="0,0,8,0" Height="32" IsEnabled="False"/>
        <Button x:Name="UpdateButton" Content="Update" Margin="0,0,8,0" Height="32" IsEnabled="False"/>
        <Button x:Name="UninstallButton" Content="Uninstall" Height="32" IsEnabled="False"/>
      </UniformGrid>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="#FF252830" CornerRadius="8" Padding="12" Margin="0,0,0,12">
          <DockPanel>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Width="96" Height="28" Margin="8,0,0,0"/>
            <TextBox x:Name="ExePath" Height="28" VerticalContentAlignment="Center"
                     Background="#FF1B1D23" Foreground="#FFF2F3F5" BorderBrush="#FF3A3F4B"/>
          </DockPanel>
        </Border>
        <Border Background="#FF252830" CornerRadius="8" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Detection"/>
            <TextBlock x:Name="DetectSummary" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="#FF9AA3B2" Text="No game selected."/>
          </StackPanel>
        </Border>
        <Border Background="#FF252830" CornerRadius="8" Padding="12" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Proxy DLL"/>
            <ComboBox x:Name="ProxyCombo" Margin="0,8,0,0" Height="28"/>
            <Expander Header="Install options" Margin="0,8,0,0" Foreground="#FFF2F3F5">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Backend"/>
                <ComboBox x:Name="BackendCombo" Margin="0,4,0,8" Height="28"/>
                <CheckBox x:Name="KeepIni" Content="Keep existing OptiScaler.ini" IsChecked="True" Foreground="#FFF2F3F5"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <Border Background="#FF252830" CornerRadius="8" Padding="12">
          <TextBox x:Name="LogView" Height="160" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Background="#FF1B1D23"
                   Foreground="#FF9AA3B2" BorderThickness="0" FontFamily="Consolas"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
